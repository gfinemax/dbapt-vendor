NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 레거시 Supabase 프로젝트 호환용. publishable key를 쓰는 경우 비워둔다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# 문서 요약·필수값 추출용 OpenAI API (서버 전용)
OPENAI_API_KEY=
# 계정에서 사용할 수 있는 파일·이미지 입력 지원 모델로 변경할 수 있다.
OPENAI_DOCUMENT_MODEL=gpt-4.1-mini

# Google People API OAuth (서버 전용)
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CONTACTS_REDIRECT_URI=
# 32바이트 키를 Base64로 인코딩한 값. 연결 후에는 변경하지 않는다.
GOOGLE_CONTACTS_TOKEN_ENCRYPTION_KEY=
